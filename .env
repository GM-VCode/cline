# ============================================================
#  .env — CONFIGURAÇÃO do servidor Qwythos-9B
#  ★ EDITE ESTE FICHEIRO para mudar modelo, visão, sampling...
#  Depois de salvar, rode de novo INICIAR-Qwythos-9B.bat
#  (o servidor precisa ser reiniciado para aplicar os cambios)
# ============================================================

# ------------------------------------------------------------
# MODELO — apunte ao .gguf que queira usar.
#   Caminhos podem ser ABSOLUTOS (C:\...) ou RELATIVOS a esta
#   pasta de trabajo. Por defecto busca en:  models\
# ------------------------------------------------------------
MODEL_PATH = C:\Users\vinic\Desktop\cline\models\Qwythos-9B-Claude-Mythos-5-1M-uncensored-heretic-Q8_0.gguf

# ALIAS é o nome que o Cline verá como "Model ID"
ALIAS = LunarIA

# ------------------------------------------------------------
# VISION (módulo de visão)
#   MM_PROJ_PATH : apunte ao archivo "*-mmproj-*.gguf"
#                  Por defecto busca em:  visao\
#   MM_PROJ_ENABLED : 1 = cargar visão | 0 = desactivarla
#                     (0/off não pasa -mm ao servidor)
# ------------------------------------------------------------
MM_PROJ_PATH = C:\Users\vinic\Desktop\cline\visao\Qwythos-9B-Claude-Mythos-5-1M-uncensored-heretic-mmproj-BF16.gguf
MM_PROJ_ENABLED = 0
IMG_MIN_TOKENS = 1024

# ------------------------------------------------------------
# REDE
# ------------------------------------------------------------
HOST = 127.0.0.1
PORT = 8080

# ------------------------------------------------------------
# HARDWARE / PERFORMANCE
# ------------------------------------------------------------
NGL = 99
THREADS = 12
CTX = 256512
BATCH = 1024
UBATCH = 512

# ------------------------------------------------------------
# SAMPLING  (deje em blanco/none para usar default do llama.cpp)
# ------------------------------------------------------------
TEMP = 0.7
TOP_K = 20
TOP_P = 0.95
MIN_P = 0.05
REPEAT_PENALTY = 1.05
SEED = -1

# ------------------------------------------------------------
# COMPORTAMENTO
# ------------------------------------------------------------
KILL_OLD_INSTANCE = 1
WAIT_HEALTH_SECONDS = 120
SHOW_CONFIG_ON_BOOT = 1