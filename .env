# ============================================================
#  .env — CONFIGURAÇÃO do servidor Qwythos-9B
#  ★ EDITE ESTE FICHEIRO para mudar modelo, visão, sampling...
#  Depois de salvar, rode de novo INICIAR-Qwythos-9B.bat
#  (o servidor precisa ser reiniciado para aplicar os cambios)
# ============================================================

# ------------------------------------------------------------
# 🧠 MODELO — apunte ao .gguf que queira usar.
#   Caminhos podem ser ABSOLUTOS (C:\...) ou RELATIVOS a esta
#   pasta de trabajo. Por defecto busca en:  models\
# ------------------------------------------------------------
# 🏷️ ALIAS é o nome que o Cline verá como "Model ID"
ALIAS = LunarIA
MODEL_PATH = C:\Users\vinic\Desktop\cline\models\Qwythos-9B-Claude-Mythos-5-1M-uncensored-heretic-Q8_0.gguf

# 🏷️ ALIAS é o nome que o Cline verá como "Model ID"
ALIAS = LunarIA

# ------------------------------------------------------------
# 👁️ VISION (módulo de visão)
#   MM_PROJ_PATH : apunte ao archivo "*-mmproj-*.gguf"
#                  Por defecto busca em:  visao\
#   MM_PROJ_ENABLED : 1 = cargar visão | 0 = desactivarla
#                     (0/off não pasa -mm ao servidor)
# ------------------------------------------------------------
MM_PROJ_PATH = C:\Users\vinic\Desktop\cline\models\MODEL_PATH = models\Qwythos-9B-Claude-Mythos-5-1M-uncensored-heretic-Q8_0.gguf

# 🏷️ ALIAS é o nome que o Cline verá como "Model ID"
ALIAS = LunarIA

# ------------------------------------------------------------
# 👁️ VISION (módulo de visão)
#   MM_PROJ_PATH : apunte ao archivo "*-mmproj-*.gguf"
#                  Por defecto busca em:  visao\
#   MM_PROJ_ENABLED : 1 = cargar visão | 0 = desactivarla
#                     (0/off não pasa -mm ao servidor)
# ------------------------------------------------------------
MM_PROJ_PATH = C:\Users\vinic\Desktop\cline\tools\visao\Qwythos-9B-Claude-Mythos-5-1M-uncensored-heretic-mmproj-BF16.gguf
MM_PROJ_ENABLED = 1
IMG_MIN_TOKENS = 1024

# ------------------------------------------------------------
# 🌐 REDE
# ------------------------------------------------------------
HOST = 127.0.0.1
PORT = 8080

# ⚡ FLASH ATTENTION (on | off | auto) — reduz a VRAM do KV cache e acelera
FLASH_ATTN = on
# 🎚️ PARALLEL — nº de slots (1 = todo o CTX para a conversa atual; Cline usa 1)
PARALLEL = 1
# 💾 KV_CACHE_TYPE — quantização do KV cache (q8_0 = ~metade da VRAM, perda mínima)
KV_CACHE_TYPE = q8_0

# ------------------------------------------------------------
# ⚙️ HARDWARE / PERFORMANCE
# ------------------------------------------------------------
NGL = 99
THREADS = 8
# 🌀 SAMPLING (creatividad)
#----------------
TEMP = 0.45
TOP_K = 40
TOP_P = 0.9
MIN_P = 0.05
#----------------
# 📏 CTX / BATCH
CTX = 100352
BATCH = 2048
UBATCH = 512
#---------------
REPEAT_PENALTY = 1.05
SEED = -1

# ------------------------------------------------------------
# 🚦 COMPORTAMENTO
# ----------------------------------------------------------------
KILL_OLD_INSTANCE = 1
WAIT_HEALTH_SECONDS = 120
SHOW_CONFIG_ON_BOOT = 1