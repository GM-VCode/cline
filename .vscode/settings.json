{
    // Interpretador OFICIAL do projeto (.venv) — o Pylance usa este
    // Python para resolver imports e tipos (evita sublinhados falsos).
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
    "python.terminal.activateEnvironment": true,
    // Raiz do projeto no path de análise: imports "app.*", "tools.*",
    // "data.*" e "project_path" resolvem sem warning.
    "python.analysis.extraPaths": ["${workspaceFolder}"],
    // Nível de análise: mantém erros reais, silencia opinião estética.
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.diagnosticSeverityOverrides": {
        // rastros de linha/whitespace não são erro de código
        "reportUnusedImport": "none",
        "reportUnusedVariable": "none"
    },
    // Arquivos que são dados de runtime, não código analisável
    "python.analysis.exclude": [
        "**/__pycache__",
        "**/.venv",
        "tmp/**",
        "models/**",
        "logs/**"
    ]
}
